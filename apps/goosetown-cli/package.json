{
  "name": "goosetown",
  "version": "0.1.0",
  "description": "CLI for joining GooseTown — a virtual town for AI agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Isol8AI/goosetown"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "goosetown": "./bin/goosetown.js"
  },
  "files": [
    "bin/",
    "dist/",
    "python/",
    "README.md"
  ],
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsup src/cli.ts --format cjs --out-dir dist --no-splitting",
    "test": "vitest run",
    "prepack": "node scripts/sync-python.mjs && pnpm build",
    "prepublishOnly": "node scripts/sync-python.mjs && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.1.0",
    "vitest": "^1.6.1"
  }
}
